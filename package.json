{
  "name": "banana-bread-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate-tracks": "python tracks_to_json.py --output src/data/tracks-sap-latest.json",
    "parse-catalogs": "python parse_catalog_pdfs.py --output src/data/tracks-pdf-latest.json",
    "merge-tracks": "python merge_track_data.py --sap src/data/tracks-sap-latest.json --pdf src/data/tracks-pdf-latest.json --output-dir src/data",
    "validate-tracks": "python merge_track_data.py --sap src/data/tracks-sap-latest.json --pdf src/data/tracks-pdf-latest.json --validate-only",
    "validate-schema": "python schema_validator.py src/data/tracks-latest.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.1"
  }
}
