{
  "name": "banana-bread-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fetch-tracks": "python3 fetch_tracks_sap.py --undergrad-only --output src/data/tracks-sap-latest.json",
    "build-tracks": "python3 build_tracks_latest.py --sap src/data/tracks-sap-latest.json",
    "update-catalog": "python3 update_course_catalog.py",
    "refresh-data": "npm run update-catalog && npm run fetch-tracks && npm run build-tracks"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}